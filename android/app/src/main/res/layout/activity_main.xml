<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layoutDirection="rtl">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Engineer Jokar" android:textSize="22sp" android:textStyle="bold" android:textColor="#3B82F6" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="یادگیری + فضای کاری شخصی" android:textSize="12sp" android:paddingBottom="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="یادگیری" android:textStyle="bold" />
        <Button android:id="@+id/btnStudyHub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🧠 مرکز یادگیری عمیق" />
        <Button android:id="@+id/btnQuiz" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📝 آزمون چهارگزینه‌ای" />
        <Button android:id="@+id/btnFlash" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🃏 کارت یادگیری / مرور" />
        <Button android:id="@+id/btnTree" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📚 فهرست درختی" />
        <Button android:id="@+id/btnCatalog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فهرست تخت" />
        <Button android:id="@+id/btnSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔍 جستجو" />
        <Button android:id="@+id/btnScenarios" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎯 Capstone / سناریو" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فضای کاری" android:textStyle="bold" android:paddingTop="8dp" />
        <Button android:id="@+id/btnTasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✅ مدیریت کارها" />
        <Button android:id="@+id/btnNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📝 یادداشت‌ها" />
        <Button android:id="@+id/btnVault" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔐 مدیریت رمز ورود" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ابزار" android:textStyle="bold" android:paddingTop="8dp" />
        <Button android:id="@+id/btnStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📊 آمار مطالعه + بانک" />
        <Button android:id="@+id/btnApi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔌 API ویندوز" />
        <Button android:id="@+id/btnJson" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📦 JSON / بکاپ" />
        <Button android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚙️ تنظیمات" />
        <Button android:id="@+id/btnReseed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔄 بازسازی محتوا" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sync" android:textStyle="bold" android:paddingTop="8dp" />
        <EditText android:id="@+id/hostInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="http://IP:5050" android:inputType="textUri" android:layoutDirection="ltr" android:textAlignment="viewStart" />
        <EditText android:id="@+id/tokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="توکن" android:inputType="textPassword" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnHello" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="اتصال" />
            <Button android:id="@+id/btnSync" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="همگام‌سازی" />
        </LinearLayout>
        <Button android:id="@+id/btnOpenWeb" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🌐 وب ویندوز" />
        <Button android:id="@+id/btnAbout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ℹ️ درباره" />

        <TextView android:id="@+id/logView" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textIsSelectable="true" android:textSize="12sp" android:typeface="monospace" android:text="…" />
    </LinearLayout>
</ScrollView>
